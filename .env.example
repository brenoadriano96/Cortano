# Banco de dados
DATABASE_URL="postgresql://user:password@localhost:5432/barbearia_saas?schema=public"

# Domínio raiz para resolução de tenant por subdomínio (produção: seu domínio no Netlify)
ROOT_DOMAIN="cortano.netlify.app"

# Senha para a rota temporária de seed remoto (/api/dev/seed?key=...)
# IMPORTANTE: use uma senha forte e remova esta variável (ou a rota) depois do setup inicial
SEED_SECRET=""

# NextAuth (Auth.js v5) — gere com: openssl rand -base64 32
AUTH_SECRET="gere-com-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# WhatsApp (Meta Cloud API) — notificações automáticas
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# Stripe (ou outro gateway de pagamento)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
